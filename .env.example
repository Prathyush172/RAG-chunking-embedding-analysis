# RFC RAG Chunking Lab — Environment Variables
# Copy this file to .env and fill in values as needed.
# Most settings have sensible defaults; only LLM keys are needed for groundedness evaluation.

# ----- LLM Provider (for Answer Groundedness evaluation, OFF by default) -----
# Options: "mock" (tests only), "ollama" (local), "openai", "gemini"
LLM_PROVIDER=mock

# Ollama (local) — start with: ollama serve
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# OpenAI (requires API key)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Gemini (requires API key)
# GOOGLE_API_KEY=AIza...
# GEMINI_MODEL=gemini-1.5-flash

# ----- Application Settings -----
# Top-k retrieved chunks (default 5)
TOP_K=5

# Minimum character overlap for a chunk to be considered relevant
MIN_OVERLAP_CHARS=40

# Random seed for reproducibility
SEED=42

# Bootstrap resampling count for confidence intervals
BOOTSTRAP_RESAMPLES=1000

# ----- Paths (relative to repo root; override only if needed) -----
# DATASETS_DIR=datasets
# CLEAN_DIR=data/clean
# EVAL_DIR=data/eval
# ARTIFACTS_DIR=artifacts
# RESULTS_DIR=results
# CACHE_DIR=.cache

# ----- Backend Server -----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ----- Frontend (Vite) -----
# VITE_API_BASE_URL=http://localhost:8000
